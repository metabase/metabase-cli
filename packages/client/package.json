{
  "name": "@metabase/client",
  "version": "0.1.4",
  "description": "Metabase API client",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metabase/metabase-cli.git",
    "directory": "packages/client"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./errors": "./dist/errors.js",
    "./json": "./dist/json.js",
    "./json-pointer": "./dist/json-pointer.js",
    "./list": "./dist/list.js",
    "./paginate": "./dist/paginate.js",
    "./poll": "./dist/poll.js",
    "./predicates": "./dist/predicates.js",
    "./signal": "./dist/signal.js",
    "./url": "./dist/url.js",
    "./auth/credential": "./dist/auth/credential.js",
    "./auth/oauth-login": "./dist/auth/oauth-login.js",
    "./auth/oauth-session": "./dist/auth/oauth-session.js",
    "./http/errors": "./dist/http/errors.js",
    "./http/oauth": "./dist/http/oauth.js",
    "./http/retry": "./dist/http/retry.js",
    "./http/transport": "./dist/http/transport.js",
    "./version/features": "./dist/version/features.js",
    "./version/input-gates": "./dist/version/input-gates.js",
    "./version/known-range": "./dist/version/known-range.js",
    "./version/profile": "./dist/version/profile.js",
    "./version/capability-error": "./dist/version/capability-error.js",
    "./version/probe": "./dist/version/probe.js",
    "./version/requirement-check": "./dist/version/requirement-check.js",
    "./version/requirements": "./dist/version/requirements.js",
    "./version/tag": "./dist/version/tag.js",
    "./domain/*.test": null,
    "./domain/*": "./dist/domain/*.js",
    "./resources/*.test": null,
    "./resources/*": "./dist/resources/*.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown",
    "prepublishOnly": "tsdown && publint"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "engines": {
    "node": ">=20.3"
  }
}
