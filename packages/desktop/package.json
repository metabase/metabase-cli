{
  "name": "@metabase/rde-desktop",
  "version": "0.0.0",
  "private": true,
  "description": "RDE desktop app",
  "license": "AGPL-3.0",
  "author": "Metabase, Inc.",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "install-electron && bun run --filter @metabase/client build && bun run --filter @metabase/rde-cli build && electron-vite dev",
    "build": "bun run --filter @metabase/client build && bun run --filter @metabase/rde-cli build && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "smoke": "bun scripts/smoke.ts",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "release-smoke": "bun scripts/release-smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.278",
    "@base-ui/react": "1.8.0",
    "@legendapp/list": "3.4.0",
    "@pierre/diffs": "1.4.3",
    "@pierre/trees": "1.0.0-beta.6",
    "class-variance-authority": "0.7.1",
    "cn": "0.3.2",
    "electron-updater": "6.8.9",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "shadow-plugin": "2.1.1",
    "yaml": "^2.8.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "playwright": "1.63.0",
    "tailwindcss": "4.3.3",
    "vite": "7.3.6"
  },
  "productName": "RDE"
}
