// mb schema timeline-event archive --output
// Objects accept keys beyond the ones listed.
type Output = {
id: number // int
name: string
description: string | null
timestamp: string
timezone: string
time_matters: boolean
icon:
| "star"
| "cake"
| "mail"
| "mail_at"
| "warning"
| "bell"
| "cloud"
| "info"
| "note"
| "event"
timeline_id: number // int
archived: boolean
creator_id: number // int
created_at: string
updated_at: string
}
