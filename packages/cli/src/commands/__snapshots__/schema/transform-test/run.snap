// mb schema transform-test run --output
// Objects accept keys beyond the ones listed.
type Output = {
status: "passed" | "failed" | "error"
expectations: (
| {
name: string
type: "equals"
status: "passed" | "failed"
columns: { name: string, database_type: string }[]
"row-counts": {
actual: number // int
expected: number // int
}
"extra-rows": Record<string, boolean | number | string | null>[]
"missing-rows": Record<string, boolean | number | string | null>[]
"cell-mismatches": {
column: string
expected: boolean | number | string | null
actual: boolean | number | string | null
}[]
truncated: number // int
}
| { name: string, type: "equals", status: "error", error: { type: string, message: string } }
| { name: string, type: "empty", status: "passed" }
| {
name: string
type: "empty"
status: "failed"
columns: { name: string, database_type: string }[]
sample: Record<string, boolean | number | string | null>[]
truncated: number // int
}
| { name: string, type: "empty", status: "error", error: { type: string, message: string } }
)[]
tables: Record<string, string>
}
