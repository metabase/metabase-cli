// mb schema card create
// Objects accept keys beyond the ones listed.
// number: int
type ParameterTarget =
| ["dimension", ["template-tag", string | { id: string }] | [string, ...unknown[]], ...unknown[]]
| ["variable", ["template-tag", string | { id: string }] | [string, ...unknown[]]]
| ["text-tag", string]
| number
| [string, ...unknown[]]
type Parameter = {
id: string
type:
| "number"
| "text"
| "date"
| "boolean"
| "date/single"
| "id"
| "category"
| "location/city"
| "location/state"
| "location/zip_code"
| "location/country"
| "date/range"
| "date/month-year"
| "date/quarter-year"
| "date/relative"
| "date/all-options"
| "temporal-unit"
| "number/!="
| "number/<="
| "number/="
| "number/>="
| "number/between"
| "string/!="
| "string/="
| "string/contains"
| "string/does-not-contain"
| "string/ends-with"
| "string/starts-with"
| "boolean/="
name?: string
slug?: string
sectionId?: string
default?: unknown
required?: boolean
filteringParameters?: string[] | null
target?: ParameterTarget
temporal_units?:
| (
| "millisecond"
| "second"
| "minute"
| "hour"
| "day"
| "week"
| "month"
| "quarter"
| "year"
| "second-of-minute"
| "minute-of-hour"
| "hour-of-day"
| "day-of-week"
| "day-of-month"
| "day-of-year"
| "week-of-year"
| "month-of-year"
| "quarter-of-year"
| "year-of-era"
| "default"
)[]
| null
values_query_type?: "list" | "search" | "none" | null
values_source_type?: "static-list" | "card" | null
values_source_config?:
| {
values?: unknown[]
card_id?: number // int
value_field?: [string, ...unknown[]]
label_field?: [string, ...unknown[]]
}
| null
}
type ParameterMapping = {
parameter_id: string
target: ParameterTarget
card_id?: number | null // int
}
type Input = {
name: string // non-empty
type?: "question" | "model" | "metric" | null
dataset_query: Record<string, unknown> // MBQL 5, legacy MBQL, or native query; refined: dataset_query must include "lib/type" (MBQL 5) or "type" (legacy MBQL/native); empty `{}` is rejected; MBQL 5 query checked against `mb schema query`
display: string // non-empty
visualization_settings: Record<string, unknown>
description?: string | null // non-empty
entity_id?: string | null // non-empty
collection_id?: number | string | null // number: int, >0; string: 21 chars, collection entity_id (21-char NanoID)
collection_position?: number | null // int; >0
cache_ttl?: number | null // int; >0
dashboard_id?: number | null // int; >0
dashboard_tab_id?: number | null // int; >0
parameters?: Parameter[] | null
parameter_mappings?: ParameterMapping[] | null
result_metadata?: unknown[] | null
}

// mb schema card create --output
// Objects accept keys beyond the ones listed.
type Output = {
id: number // int
name: string
type: "question" | "model" | "metric"
display: string
description: string | null
archived: boolean
query_type: "native" | "query" | null
database_id: number | null // int
table_id: number | null // int
collection_id: number | null // int
dashboard_id?: number | null // int
entity_id: string | null
creator_id: number // int
dataset_query: unknown
visualization_settings: unknown
}
