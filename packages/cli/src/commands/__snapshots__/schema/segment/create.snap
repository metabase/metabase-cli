// mb schema segment create
// Objects accept keys beyond the ones listed.
type Input = {
name: string // non-empty
table_id: number // int; >0; dropped by tableFromDefinition (v64+)
definition: Record<string, unknown> // MBQL query holding the filter; MBQL 5 query checked against `mb schema query`
description?: string | null
}

// mb schema segment create --output
// Objects accept keys beyond the ones listed.
type Output = {
id: number // int
name: string
description: string | null
archived: boolean
table_id: number // int
definition: unknown
creator_id: number // int
entity_id: string | null
show_in_getting_started: boolean | null
caveats: string | null
points_of_interest: string | null
definition_description?: string | null
created_at: string
updated_at: string
}
