// mb schema skills get --output
type Output = {
// The items in this window.
data: {
name: string
description: string
body: string
references: { path: string, content: string }[]
templates: { path: string, content: string }[]
}[]
returned: number // int; >=0; Number of items in `data`; a short window is not proof the walk is over.
offset: number // int; >=0; Index of the first item in `data` within the full result set.
limit?: number // int; >=0; Echoes `--limit` when you passed one, and is absent otherwise.
total?: number | null // int; >=0; The server's count on endpoints that report one and `null` on those that don't, so it is a display value rather than a loop bound.
has_more: boolean // True when more items exist beyond this window; this alone decides whether to keep going, never a comparison of counts. True with a `null` next_offset means the remaining items are reached by widening `--max-bytes` or narrowing the selection, not by paging.
next_offset?: number | null // int; >=0; Pass back as `--offset` to fetch the next window; it is past the offset you sent, and `null` when there is nowhere to resume from — either the walk is over or `--max-bytes` left no room for a single row, which `truncated` tells apart.
// Present when the `--max-bytes` cap cut the output, not when the data ran out; its `bytes` is what the untruncated answer would have measured, so narrow rows with `--fields` rather than raising the cap.
truncated?: {
reason: "max_bytes"
bytes: number // int; >=0
}
// Skills left out because the profile's server lacks a feature they need, each with the client's account of the first one missing; `null` when nothing was filtered — `--unfiltered` was passed, or the profile has no cached server probe to filter by.
unavailable:
| {
name: string
failure: {
reason: "version-too-old" | "missing-token-feature" | "superseded-by-feature"
detail: string
feature:
| "dataActionCollections"
| "dataActionsWithoutModel"
| "transforms"
| "transformJobActivation"
| "measures"
| "library"
| "libraryDashboards"
| "remoteSync"
| "remoteSyncRemoteChanges"
| "remoteSyncCollectionsOnlyUpdate"
| "remoteSyncExportPreflight"
| "remoteSyncBranchGuard"
| "remoteSyncMerge"
| "contentTranslation"
| "contentVerification"
| "transformTargetTableId"
| "transformTargetTableLinkedOnCreate"
| "transformJobRunIdIsNumeric"
| "transformCheckpointReset"
| "fieldDataSensitivity"
| "fieldRemappingAppendsDisplayColumns"
| "transformDagRuns"
| "unifiedTransformRuns"
| "transformTests"
| "libraryChildrenCarryType"
| "collectionItemsTotalOnEmptyPage"
| "invalidMbqlIsBadRequest"
| "boxplotDisplay"
| "nativeTableTemplateTag"
| "smartLinkMeasureModel"
| "dashboardSubscriptionFilters"
| "dependencyGraph"
| "dependencyItemListings"
| "dependencyAsyncBackfill"
| "measureDependencyGraph"
| "tableListAccessFilters"
| "tableListTransformTargets"
| "tableListPublishedFilter"
| "tableUnusedFilter"
| "tableDataLayerTiers"
| "bulkTableEdit"
| "tableUserValueWithdrawal"
| "bulkTableSync"
| "erd"
| "documentCopy"
| "transformInspector"
| "pythonLibrary"
| "pythonTestRun"
| "sourceReplacement"
| "metricDefinitionQuery"
| "metricDimensionListing"
| "oauthFullAccessScopeUnadvertised"
| "exportCsvByteOrderMark"
since: number // int
tokenFeature: string | null
serverVersion: string
}
}[]
| null
}
